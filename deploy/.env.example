SUBMODHUB_PORT=18082
POSTGRES_PASSWORD=replace-with-a-long-random-password
FLARUM_URL=https://forum.monika.love/
ADMIN_FLARUM_GROUP_IDS=16,22
# Skip manual review for new submissions and scanned GitHub releases.
SUBMODHUB_AUTO_PUBLISH=false
# Optional. Leave empty: the refresh window is configured in the admin settings
# page (default 60m). Set e.g. 60m only to pin it for this deployment.
GITHUB_SYNC_MAX_AGE=
# Base64 of exactly 32 cryptographically random bytes. Keep with database backups.
# Empty disables saving new delivery credentials; never commit a real key.
SUBMODHUB_DELIVERY_MASTER_KEY=
